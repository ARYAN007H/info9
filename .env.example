# Port the Express server listens on (serves both the API and the built UI)
PORT=3000

# Set to "production" to serve the pre-built dist/ instead of the Vite dev server
NODE_ENV=development

# OPTIONAL — enables AI photo geolocation only (POST /api/osint/vision-geolocate).
# Get a free key at https://aistudio.google.com/apikey. Every other info9
# feature runs fully zero-key without this.
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL=
